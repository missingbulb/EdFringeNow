{
  "version": 1,
  "settings": {
    "path": ".claudinite/settings.yaml",
    "format": "yaml"
  },
  "engine": {
    "package": "@claudinite/cli",
    "version": "1.61009.2",
    "channel": "staging"
  },
  "packs": {
    "channel": "canary",
    "declared": [
      {
        "id": "basics"
      },
      {
        "id": "claudinite-lifecycle"
      },
      {
        "id": "git-github"
      },
      {
        "id": "html"
      },
      {
        "id": "claudinite-growth",
        "config": {
          "retention_days": 10
        }
      },
      {
        "id": "local/edfringe-now"
      },
      {
        "id": "executable-requirements",
        "config": {
          "spec": "product/requirements.md"
        }
      },
      {
        "id": "spec-driven-product"
      },
      {
        "id": "product-wiki"
      },
      {
        "id": "claude-code-web-users-support",
        "config": {
          "repo": "missingbulb/Shepherd"
        }
      },
      {
        "id": "cloudflare-site"
      },
      {
        "id": "public-website"
      }
    ]
  },
  "dormant": false,
  "held": {
    "basics": "1.61008.1",
    "claude-code-web-users-support": "1.61005.1",
    "claudinite-growth": "1.61009.1",
    "claudinite-lifecycle": "1.61008.1",
    "cloudflare-site": "1.61009.1",
    "executable-requirements": "1.61004.1",
    "git-github": "1.61008.2",
    "html": "1.61004.1",
    "product-wiki": "1.61008.1",
    "public-website": "1.61005.1",
    "spec-driven-product": "1.61004.1"
  }
}
