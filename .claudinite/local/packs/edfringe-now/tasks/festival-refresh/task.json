{
  "$schema": "../../../../../shared/packs/claudinite-tasks/task.schema.json",
  "id": "festival-refresh",
  "description": "Stage 4 of the data lifecycle beyond the Fringe: re-runs the ticket-availability tools of every festival edition near or in its run, and delivers what moved beyond fetch times.",
  "schedule_after": [
    "edfringe-now/festival-update"
  ],
  "trigger": "schedule",
  "preconditions": [
    "festival-in-refresh-window"
  ],
  "expected_outcome": "supersede_existing_pr",
  "automerge": [
    "under:data/festivals",
    "under:site/data/festivals"
  ],
  "code_worker_mjs": "worker.mjs",
  "code_work_timeout": 1800,
  "agent_model": "none"
}
