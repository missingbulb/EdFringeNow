# Raw scrape cache (events/venues/genres JSON) — regenerated by scraper/fetch_shows.py.
# The normalized, website-ready data under data/normalized, data/venues.json and
# data/days IS committed; only the bulky raw cache is ignored.
data/raw_pages/

# Claudinite shared guidelines, synced over HTTPS by a SessionStart hook
# (see .claudinite/mount/sync-claudinite.sh). Not committed — refreshed each session;
# only the tracked hook under mount/ and the repo's own .claudinite/local_packs/
# (project packs) are committed.
/.claudinite/*
/.claudinite.new/
!/.claudinite/mount/
/.claudinite/mount/*
!/.claudinite/mount/sync-claudinite.sh
!/.claudinite/local_packs/
/.claudinite-hooks.log
/.claudinite-hooks.log.tmp

# Python bytecode cache
__pycache__/
*.pyc
