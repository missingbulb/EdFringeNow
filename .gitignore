# Raw scrape cache (events/venues/genres JSON) — regenerated by scraper/fetch_shows.py.
# The normalized, website-ready data under data/normalized, data/venues.json and
# data/days IS committed; only the bulky raw cache is ignored.
data/raw_pages/

# Claudinite: .claudinite/* stays ignored wholesale with re-includes — only shared/
# (the vendored canon, refreshed by the nightly maintenance) and local_packs/ (the
# repo's own packs) are tracked, so legacy flat leftovers or a stale environment's
# stray sync stay invisible.
/.claudinite/*
!/.claudinite/shared/
!/.claudinite/local_packs/
/.claudinite-hooks.log
/.claudinite-hooks.log.tmp

# Python bytecode cache
__pycache__/
*.pyc
